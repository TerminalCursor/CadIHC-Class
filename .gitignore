# Ignore everything by default
/*
/**/*.*
!.gitignore

# Allow Workflows
!.gitea/
!.gitea/workflows/
!.gitea/workflows/*.yaml

# Allow source files
!pc_util
!src
!scripts
!helper_scripts
!/**/*.py

# Allow tests
!tests
!tests/inputs/**/*.*
# Ignore test outputs
tests/outputs/**/*
# Keep directory
!tests/outputs/.gitignore

# Allow environment configurations
!pixi.lock
!pixi.toml
!pyproject.toml

# Ignore pixi environments
.pixi/*
!.pixi/config.toml

# Keep pyright type checking configuration
!strict.json

# Keep readme
!README.md

# Keep model files
!ihc
!ihc/models/classification/**/*.*
